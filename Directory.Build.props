<Project>

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RepositoryUrl>https://github.com/shayanhabibi/FSharp.QuestPDF</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Authors>shayanhabibi</Authors>
        <Copyright>Copyright © 2026 shayanhabibi</Copyright>
    </PropertyGroup>

    <!-- Packages ship a symbol package, and Source Link maps the PDBs to the commit on GitHub. -->
    <PropertyGroup>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <PropertyGroup>
        <FsDocsAllowExecutableProject>true</FsDocsAllowExecutableProject>
        <PackageProjectUrl>https://shayanhabibi.github.io/FSharp.QuestPDF</PackageProjectUrl>
        <FsDocsLicenseLink>https://github.com/shayanhabibi/FSharp.QuestPDF/blob/master/LICENSE</FsDocsLicenseLink>
    </PropertyGroup>

    <!--
    Projects opting out of the root build set IsExcludedFromRootBuild, which
    Directory.Build.targets turns into a no-op Build. Used for Fable projects,
    which are compiled by the fable tool rather than by MSBuild.
    -->
    <PropertyGroup Condition="'$(IsExcludedFromRootBuild)' == 'true'">
        <IsPackable>false</IsPackable>
    </PropertyGroup>

</Project>

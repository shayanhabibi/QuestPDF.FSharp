<Project>

    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <RepositoryUrl>https://github.com/shayanhabibi/QuestPDF.FSharp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Authors>shayanhabibi</Authors>
    </PropertyGroup>

    <PropertyGroup>
        <FsDocsAllowExecutableProject>true</FsDocsAllowExecutableProject>
        <PackageProjectUrl>https://shayanhabibi.github.io/QuestPDF.FSharp</PackageProjectUrl>
        <FsDocsLicenseLink>https://github.com/shayanhabibi/QuestPDF.FSharp/blob/master/LICENSE</FsDocsLicenseLink>
    </PropertyGroup>

    <!--
    Projects opting out of the root build set IsExcludedFromRootBuild, which
    Directory.Build.targets turns into a no-op Build. Used for Fable projects,
    which are compiled by the fable tool rather than by MSBuild.
    -->
    <PropertyGroup Condition="'$(IsExcludedFromRootBuild)' == 'true'">
        <IsPackable>false</IsPackable>
    </PropertyGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <GenerateProgramFile>false</GenerateProgramFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Support/Deterministic.fs" />
        <Compile Include="Support/Equivalence.fs" />
        <Compile Include="Support/PdfText.fs" />
        <Compile Include="UnitsTests.fs" />
        <Compile Include="CoreTests.fs" />
        <Compile Include="StyleTests.fs" />
        <Compile Include="TextTests.fs" />
        <Compile Include="DocumentTests.fs" />
        <Compile Include="GenerateTests.fs" />
        <Compile Include="ModifierTests.fs" />
        <Compile Include="ExamplesTests.fs" />
        <Compile Include="Main.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Expecto" Version="11.0.0-alpha8" />
        <PackageReference Include="Expecto.FsCheck" Version="11.0.0-alpha8-fscheck2" />
        <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.15.5" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
        <PackageReference Include="PdfPig" Version="0.1.16" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\QuestPDF.FSharp\QuestPDF.FSharp.fsproj" />
    </ItemGroup>

</Project>

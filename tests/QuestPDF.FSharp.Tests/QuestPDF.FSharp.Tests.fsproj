<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <GenerateProgramFile>false</GenerateProgramFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Support/Deterministic.fs" />
        <Compile Include="Support/Equivalence.fs" />
        <Compile Include="Support/PdfText.fs" />
        <Compile Include="Support/Fonts.fs" />
        <Compile Include="UnitsTests.fs" />
        <Compile Include="CoreTests.fs" />
        <Compile Include="StyleProbe.fs" />
        <Compile Include="StyleTests.fs" />
        <Compile Include="TextTests.fs" />
        <Compile Include="DocumentTests.fs" />
        <Compile Include="GenerateTests.fs" />
        <Compile Include="OperationsTests.fs" />
        <Compile Include="ModifierTests.fs" />
        <Compile Include="LayoutColumnRowTests.fs" />
        <Compile Include="TextRichTests.fs" />
        <Compile Include="TableTests.fs" />
        <Compile Include="SemanticTests.fs" />
        <Compile Include="LayersDecorationTests.fs" />
        <Compile Include="FlowTests.fs" />
        <Compile Include="ElementsTests.fs" />
        <Compile Include="PagingTests.fs" />
        <Compile Include="TransformTests.fs" />
        <Compile Include="DynamicTests.fs" />
        <Compile Include="OutputTests.fs" />
        <Compile Include="SetupTests.fs" />
        <Compile Include="Coverage.fs" />
        <Compile Include="CoverageTests.fs" />
        <Compile Include="../../build/QuestPdfLinks.fs" Link="Support/QuestPdfLinks.fs" />
        <Compile Include="DocsTests.fs" />
        <Compile Include="ExamplesTests.fs" />
        <Compile Include="Main.fs" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Fixtures/swatch.png" LogicalName="swatch.png" />
        <EmbeddedResource Include="Fixtures/noise.png" LogicalName="noise.png" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Expecto" Version="11.0.0-alpha8" />
        <PackageReference Include="Expecto.FsCheck" Version="11.0.0-alpha8-fscheck2" />
        <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.15.5" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
        <PackageReference Include="PdfPig" Version="0.1.16" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\QuestPDF.FSharp\QuestPDF.FSharp.fsproj" />
    </ItemGroup>

</Project>

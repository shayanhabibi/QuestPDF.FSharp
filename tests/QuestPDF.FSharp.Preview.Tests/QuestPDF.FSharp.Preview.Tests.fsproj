<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <GenerateProgramFile>false</GenerateProgramFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Support/Ports.fs" />
        <Compile Include="Support/Fonts.fs" />
        <Compile Include="Support/FakeSageFs.fs" />
        <Compile Include="FontFaceTests.fs" />
        <Compile Include="SnapshotTests.fs" />
        <Compile Include="ScheduleTests.fs" />
        <Compile Include="ExecProtocolTests.fs" />
        <Compile Include="SageFsProtocolTests.fs" />
        <Compile Include="ChangeFilterTests.fs" />
        <Compile Include="ServerTests.fs" />
        <Compile Include="ScriptReloadTests.fs" />
        <Compile Include="DocsTests.fs" />
        <Compile Include="Main.fs" />
        <EmbeddedResource Include="Fixtures/sagefs-0.6.828/*" LogicalName="sagefs-0.6.828/%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Expecto" Version="11.0.0-alpha8" />
        <PackageReference Include="Expecto.FsCheck" Version="11.0.0-alpha8-fscheck2" />
        <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.15.5" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\QuestPDF.FSharp.Preview\QuestPDF.FSharp.Preview.fsproj" />
    </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <RootNamespace>FSharp.QuestPDF</RootNamespace>
        <AssemblyName>FSharp.QuestPDF.Preview</AssemblyName>
        <PackageId>FSharp.QuestPDF.Preview</PackageId>
        <Title>FSharp.QuestPDF.Preview</Title>
        <Version>0.1.0</Version>
        <Description>Live browser previews of FSharp.QuestPDF documents, reloaded on save under SageFs.</Description>
        <PackageTags>fsharp;f#;pdf;questpdf;preview;hot-reload;sagefs</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- Deterministic source paths in the packaged PDBs. Only the packages set it: the tests find repository
             files through __SOURCE_DIRECTORY__, which it rewrites to /_/. -->
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="FontFace.fs" />
        <Compile Include="Snapshot.fs" />
        <Compile Include="Schedule.fs" />
        <Compile Include="ExecProtocol.fs" />
        <Compile Include="SageFsProtocol.fs" />
        <Compile Include="ChangeFilter.fs" />
        <Compile Include="Http.fs" />
        <Compile Include="Shell.fs" />
        <Compile Include="Renderer.fs" />
        <Compile Include="SageFs.fs" />
        <Compile Include="Preview.fsi" />
        <Compile Include="Preview.fs" />
        <EmbeddedResource Include="Shell.html" LogicalName="Shell.html" />
        <None Include="../../README.md" Pack="true" PackagePath="\" />
        <InternalsVisibleTo Include="FSharp.QuestPDF.Preview.Tests" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\FSharp.QuestPDF\FSharp.QuestPDF.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="FSharp.Core" Version="10.0.100" />
    </ItemGroup>

</Project>
